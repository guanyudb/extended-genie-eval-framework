{
 "datasets": [
  {
   "name": "ds_core",
   "displayName": "Core question health (current)",
   "queryLines": [
    "SELECT source, core_id, core_label, variations, pass, fail, pass_rate, health_status, last_evaluated ",
    "FROM core_health_current ORDER BY core_id"
   ]
  },
  {
   "name": "ds_failures",
   "displayName": "Triaged failures (ai_decide)",
   "queryLines": [
    "SELECT 'native_eval_run' AS source, test_id, core_id, question, failure_category, failure_confidence, ",
    "       p_semantically_equivalent, severity, triage_route, genie_sql, gt_sql ",
    "FROM native_diagnostics ",
    "UNION ALL ",
    "SELECT 'mlflow_harness', test_id, core_id, question, failure_category, failure_confidence, ",
    "       semantically_equivalent_p, severity, ",
    "       CASE WHEN semantically_equivalent_p >= 0.8 THEN 'likely_false_negative' WHEN failure_confidence < 0.6 THEN 'human_review' ELSE 'auto_triaged' END, ",
    "       genie_sql, NULL ",
    "FROM harness_results ",
    "WHERE run_id <> 'e71aa54c7a3c424a9074e2a3e59f6e20' ",
    "QUALIFY ROW_NUMBER() OVER (PARTITION BY test_id ORDER BY run_ts DESC) = 1 ",
    "  AND NOT passed AND failure_category IS NOT NULL AND failure_category <> 'none'"
   ]
  }
 ],
 "pages": [
